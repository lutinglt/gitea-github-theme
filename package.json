{
  "name": "@lutinglt/gitea-github-theme",
  "version": "28.3.0",
  "license": "Apache-2.0",
  "author": {
    "name": "lutinglt",
    "url": "https://github.com/lutinglt"
  },
  "type": "module",
  "exports": {
    "./*": "./src/*/index.ts",
    "./themeConfig": "./src/themeConfig.ts",
    "./assets": "./assets/index.ts"
  },
  "scripts": {
    "build": "bun run --bun vite build",
    "bundle": "bun check && bun run build",
    "bundle:ci": "bun bundle && bun vitest",
    "bundle:release": "bun bundle && bun update:locale",
    "check": "tsc -b && oxlint",
    "commit": "bun fmt && bun bundle && bun vitest",
    "dev": "bun bundle && bun update:theme",
    "fix": "oxlint --fix",
    "fix:imports": "oxlint --fix -A all -D import/no-duplicates",
    "fmt": "oxfmt && bun fix:imports",
    "fmt:check": "oxfmt --check",
    "install:clean": "rm -rf node_modules bun.lock bun.lockb && bun install",
    "update:arcgreen": "bun scripts/updateArcGreen.ts",
    "update:gitea": "bun scripts/updateGitea.ts",
    "update:locale": "bun scripts/translate.ts",
    "update:primer": "bun scripts/buildPrimerTSToken.ts",
    "update:snapshot": "bun vitest --update",
    "update:theme": "bun scripts/syncTheme.ts",
    "version": "bun scripts/version.ts"
  },
  "devDependencies": {
    "@catppuccin/palette": "1.8.0",
    "@primer/primitives": "11.10.0",
    "@styled/typescript-styled-plugin": "^1.1.1",
    "@types/node": "^25.9.5",
    "@vanilla-extract/css": "^1.21.2",
    "color2k": "^2.0.4",
    "dotenv": "^17.4.2",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "style-dictionary": "^5.5.3",
    "typescript": "^7.0.2",
    "undici": "^7.29.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
